<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        prefHeight="720.0"
        prefWidth="1100.0"
        styleClass="app-shell"
        xmlns="http://javafx.com/javafx/17"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="zinc.javafx.MainWindow">

    <left>
        <VBox
                prefWidth="200.0"
                styleClass="sidebar">

            <Button
                    maxWidth="Infinity"
                    onAction="#newConversation"
                    styleClass="new-chat"
                    text="New conversation" />

            <Region VBox.vgrow="ALWAYS" />

            <Button
                    maxWidth="-Infinity"
                    onAction="#exitProgram"
                    styleClass="sidebar-link"
                    text="Exit" />
        </VBox>
    </left>

    <center>
        <BorderPane styleClass="chat-pane">
            <top>
                <HBox
                        alignment="CENTER_LEFT"
                        spacing="14"
                        styleClass="topbar">
                    <VBox HBox.hgrow="ALWAYS" />
                    <Label
                            styleClass="active"
                            text="Ready to receive instruction" />
                </HBox>
            </top>

            <center>
                <ScrollPane
                        fx:id="scrollPane"
                        fitToWidth="true"
                        hbarPolicy="NEVER"
                        styleClass="message-scroll">
                    <content>
                        <VBox
                                fx:id="dialogContainer"
                                fillWidth="true"
                                spacing="16"
                                styleClass="messages" />
                    </content>
                </ScrollPane>
            </center>

            <bottom>
                <VBox
                        spacing="10"
                        styleClass="composer-wrap">
                    <HBox spacing="8">
                        <Button
                                onAction="#printHelp"
                                styleClass="quickCommand"
                                text="Command List" />
                    </HBox>

                    <HBox
                            spacing="10"
                            styleClass="composer">
                        <TextField
                                fx:id="userInput"
                                onAction="#handleUserInput"
                                promptText="Message Zinc..."
                                HBox.hgrow="ALWAYS" />
                        <Button
                                fx:id="sendButton"
                                onAction="#handleUserInput"
                                styleClass="send-button"
                                text=">" />
                    </HBox>
                </VBox>
            </bottom>
        </BorderPane>
    </center>
</BorderPane>
